#!/bin/bash

CONTAINER_NAME="chatmock-fnos"

is_running() {
  docker inspect "$CONTAINER_NAME" 2>/dev/null | grep -q '"Status": "running"'
}

case "$1" in
  start|stop)
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/tmp/chatmock-fnos.log}"
    exit 1
    ;;
esac
